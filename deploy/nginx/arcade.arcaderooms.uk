# /etc/nginx/sites-available/arcade.arcaderooms.uk
# Arcade AI — FastAPI uvicorn :8014
#
# Subdomain only. Moodle Explorer is at https://arcaderooms.uk
#
# After DNS A for arcade.arcaderooms.uk points here:
#   sudo certbot --nginx -d arcade.arcaderooms.uk

server {
    listen 80;
    listen [::]:80;
    server_name arcade.arcaderooms.uk;

    client_max_body_size 60M;

    location / {
        proxy_pass http://127.0.0.1:8014;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location /ws/play {
        proxy_pass http://127.0.0.1:8014;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }
}
