# /etc/nginx/sites-available/machinelearning-arcade.pablodiaz.eu
# Subdominio Arcade AI — proxy a FastAPI (:8014).
#
# NOTE: this is the pre-certbot, HTTP-only version. Once DNS for
# machinelearning-arcade.pablodiaz.eu points at this server, run:
#   sudo certbot --nginx -d machinelearning-arcade.pablodiaz.eu
# Certbot will rewrite this file in place to add the 443/TLS server block and
# the 80->443 redirect, exactly like it already did for
# /etc/nginx/sites-available/machinelearning.pablodiaz.eu.

server {
    listen 80;
    listen [::]:80;
    server_name machinelearning-arcade.pablodiaz.eu;

    client_max_body_size 60M;  # ROM uploads up to 50MB (see web/app.py MAX_UPLOAD_BYTES)

    location / {
        proxy_pass http://127.0.0.1:8014;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location /ws/play {
        proxy_pass http://127.0.0.1:8014;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }
}
