# /etc/nginx/sites-available/arcaderooms.uk
# Arcade Explore Rooms — proxy a FastAPI Arcade AI (:8014).
#
# Pre-certbot HTTP-only. After DNS A records for arcaderooms.uk (+ www)
# point at this Lightsail box:
#   sudo certbot --nginx -d arcaderooms.uk -d www.arcaderooms.uk

server {
    listen 80;
    listen [::]:80;
    server_name arcaderooms.uk www.arcaderooms.uk;

    client_max_body_size 60M;

    location / {
        proxy_pass http://127.0.0.1:8014;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location /ws/play {
        proxy_pass http://127.0.0.1:8014;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }
}
